# Copie este arquivo para ".env" e ajuste os valores antes de subir o sistema.

# --- Uso com Docker/VPS (docker-compose.yml) ---
POSTGRES_DB=agro_erp
POSTGRES_USER=agro_erp
POSTGRES_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo-bem-grande-e-aleatorio

# --- Uso no free tier (Render + Supabase + Netlify) ---
# Cole aqui a "Connection string" do Supabase (Project Settings > Database).
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# Project Settings > API, no painel do Supabase.
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_SERVICE_KEY=cole-aqui-a-service-role-key
SUPABASE_BUCKET=anexos
# Endereço do backend publicado no Render (usado pelo frontend no Netlify).
VITE_API_URL=https://SEUBACKEND.onrender.com/api
