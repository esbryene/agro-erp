{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "./backend/Dockerfile"
  },
  "deploy": {
    "startCommand": "node src/migrate.js && node src/seed.js && node src/index.js",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
